{
  "name": "ETIPOS P2P File Transfer",
  "short_name": "ETIPOS",
  "id": "/",
  "description": "Secure local and distance file transfer fortress with zero-trust malware analysis",
  "start_url": "/static/index.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a0c",
  "theme_color": "#0a0a0c",
  "orientation": "portrait-primary",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["*/*"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+etipos",
      "url": "/static/index.html?token=%s"
    }
  ],
  "categories": ["utilities", "security", "productivity"],
  "screenshots": [],
  "related_applications": [],
  "prefer_related_applications": false
}
