# ETIPOS Local & Distance Configuration
SERVER_PORT=8000
VAULT_TTL_HOURS=24

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Option A — Dashboard Tunnel via Token (RECOMMENDED):
#   In Cloudflare Zero Trust Dashboard -> Tunnels -> Configure tunnel -> "Install and run connector"
#   Copy the token after "--token" and paste below.
#   Also enter your Public Hostname/Domain configured in the dashboard (e.g. https://relay.yourdomain.com):
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_TUNNEL_URL=

# Option B — Named Tunnel via CLI cert
CLOUDFLARE_TUNNEL_NAME=

# Option C — Quick Tunnel (default when Token and Name are empty)
#   Zero setup, but temporary random URL changes each launch.
# ─────────────────────────────────────────────────────────────────────────────

# Gmail SMTP Settings for link email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ETIPOS Relay

