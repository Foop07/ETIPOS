# ETIPOS P2P File Transfer - Configuration Examples
# Copy this file to .env and fill in your values

# =============================================================================
# Server Configuration
# =============================================================================

# FastAPI HTTPS server port (default: 8000)
SERVER_PORT=8000

# =============================================================================
# Cloudflare Tunnel Configuration
# =============================================================================

# OPTION A — Named Tunnel (RECOMMENDED)
# Gives you a PERMANENT fixed URL so the Android PWA only needs to be
# installed once. The URL never changes between launches.
#
# One-time setup (takes ~2 minutes, free Cloudflare account):
#   1. cloudflared tunnel login                 # browser OAuth, once ever
#   2. cloudflared tunnel create etipos         # creates tunnel, saves credentials
#   3. Set CLOUDFLARE_TUNNEL_NAME=etipos below
#
# Your permanent URL will look like:
#   https://<uuid>.cfargotunnel.com
# (or a custom domain you route to it in the Cloudflare dashboard)
#
CLOUDFLARE_TUNNEL_NAME=

# OPTION B — Quick Tunnel (default when CLOUDFLARE_TUNNEL_NAME is empty)
# No account needed. Works instantly but generates a NEW random URL every
# launch, so the Android PWA must be reinstalled after each server restart.

# =============================================================================
# P2P Configuration
# =============================================================================

# P2P transfer expiry time in seconds
# Default: 300 (5 minutes for testing)
# Production: 259200 (3 days = 60 * 60 * 24 * 3)
P2P_EXPIRY_SECONDS=60

# WebTorrent tracker port (default: 8001)
TRACKER_PORT=8001

# Optional: Custom TURN server for NAT traversal
# Format: turn:your-turn-server:3478
# Leave empty to use public STUN only
TURN_SERVER_URL=

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================

# SMTP server host
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username (your email address)
SMTP_USER=your-email@gmail.com

# SMTP password or app password
# For Gmail: Use an App Password (16 characters)
# Enable 2FA on your Google account, then generate an app password
SMTP_PASSWORD=your-app-password

# From email address
# Format: ETIPOS <your-email@gmail.com>
EMAIL_FROM=ETIPOS <your-email@gmail.com>

# =============================================================================
# Example Configurations
# =============================================================================

# --- Development/Testing ---
# P2P_EXPIRY_SECONDS=60
# TRACKER_PORT=8001

# --- Production ---
# P2P_EXPIRY_SECONDS=259200
# TRACKER_PORT=8001

# =============================================================================
# How to Get Gmail App Password
# =============================================================================
# 1. Go to your Google Account (myaccount.google.com)
# 2. Go to Security
# 3. Enable 2-Step Verification
# 4. Go to App Passwords (search "app password" in search)
# 5. Create a new app password for "ETIPOS"
# 6. Use the 16-character password in SMTP_PASSWORD
#
# Note: Regular Gmail passwords won't work - you MUST use an App Password